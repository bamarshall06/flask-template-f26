# Copy this file to .env for local development. Never commit .env.
#
# ---------------------------------------------------------------------------
# Module 3: you do not need any of this. The app runs with no .env at all.
# ---------------------------------------------------------------------------

# FLASK_SECRET_KEY signs session cookies. Without it the app still starts, but
# makes up a throwaway key each time, so anyone logged in gets logged out on
# every restart. Set it once you have logins.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Module 4 onward: your database.
# ---------------------------------------------------------------------------
# The connection string your instructor gives you when your database is
# created. Leave it empty and the app runs fine without a database - the
# Examples page just explains that there is not one yet.
#
#   mysql://username:password@host:3306/database_name
#
# If your password contains @ / # or +, percent-encode it (@ becomes %40).
DATABASE_URL=
