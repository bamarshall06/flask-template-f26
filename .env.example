# Copy this file to .env for local development. Never commit .env.
#
# ---------------------------------------------------------------------------
# Module 3: you do not need any of this. The app runs with no .env at all.
# ---------------------------------------------------------------------------

# FLASK_SECRET_KEY signs session cookies. Without it the app still starts, but
# makes up a throwaway key each time, so anyone logged in gets logged out on
# every restart. Set it once you have logins.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Module 4 onward: your database.
# ---------------------------------------------------------------------------
# On the class server this is set on your Dokku app, NOT here: use the
# config:set command from your Deployments page. Its host (172.17.0.1) only
# exists on the server, so a value here makes the app on your laptop hang.
# Leave it empty - the app runs fine, and database pages say there is no
# database yet. Test database pages on your live app.
#
#   mysql://username:password@host:3306/database_name
DATABASE_URL=
